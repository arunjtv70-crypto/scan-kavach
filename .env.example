# Gemini Provider (Recommended for Vercel)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# Ollama Hosted Provider (Alternative)
OLLAMA_BASE_URL=https://your-hosted-ollama.com
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_MODEL=gemma4:31b

# Local Development fallback:
# If none of the above are set, development environment will use http://localhost:11434 automatically
